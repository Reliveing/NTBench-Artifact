+def _pow_safe(base, exp):
+    """Create a power ``base**exp`` without evaluating if ``exp`` is an Integer.
+
+    This prevents the expensive computation of large integer powers.
+    """
+    if exp is S.One:
+        return base
+    if isinstance(exp, int) or exp.is_Integer:
+        return Pow(base, exp, evaluate=False)
+    return base**exp
+
