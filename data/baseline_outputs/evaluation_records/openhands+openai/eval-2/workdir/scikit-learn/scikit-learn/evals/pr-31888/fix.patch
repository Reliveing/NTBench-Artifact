+# Large input values can make liblinear's internal TRON solver overflow and
+# stall. The threshold is conservative: TRON can form products involving
+# squared feature values and gradients, so values above the fourth root of the
+# largest float64 are numerically unsafe.
+_LIBLINEAR_MAX_INPUT_VALUE = np.finfo(np.float64).max ** 0.25
+
+
+def _check_liblinear_large_input(X):
+    if sp.issparse(X):
+        max_val = np.max(np.abs(X.data)) if X.data.size else 0.0
+    else:
+        max_val = np.max(np.abs(X))
+
+    if max_val > _LIBLINEAR_MAX_INPUT_VALUE:
+        warnings.warn(
+            "The liblinear solver may fail to converge with features containing "
+            "large values. Consider preprocessing your data by scaling or "
+            "standardizing features with StandardScaler or MinMaxScaler.",
+            ConvergenceWarning,
+            stacklevel=2,
+        )
+
 
 def _one_vs_one_coef(dual_coef, n_support, support_vectors):
