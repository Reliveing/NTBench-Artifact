+def _get_schema_from_local_json_ref(json_schema: JsonSchemaValue, json_ref: JsonRef) -> Any | None:
+    if json_ref == '#':
+        return json_schema
+    if not json_ref.startswith('#/'):
+        return None
+
+    current_schema: Any = json_schema
+    for part in json_ref[2:].split('/'):
+        part = part.replace('~1', '/').replace('~0', '~')
+        if isinstance(current_schema, dict):
+            try:
+                current_schema = current_schema[part]
+            except KeyError:
+                return None
+        elif isinstance(current_schema, list):
+            try:
+                current_schema = current_schema[int(part)]
+            except (IndexError, ValueError):
+                return None
+        else:
+            return None
+    return current_schema
+
