+def _linspace_from_dask(start, stop, num, endpoint, retstep, chunks, dtype):
+    token = tokenize((start, stop, num, endpoint, chunks, dtype))
+    name = "linspace-" + token
+    (start_ref, stop_ref), deps = unpack_collections([start, stop])
+
+    dsk = {}
+    blockstart = 0
+    for i, blocksize in enumerate(chunks[0]):
+        dsk[(name, i)] = (
+            _linspace_chunk,
+            start_ref,
+            stop_ref,
+            num,
+            endpoint,
+            dtype,
+            blockstart,
+            blocksize,
+        )
+        blockstart += blocksize
+
+    graph = HighLevelGraph.from_collections(name, dsk, dependencies=deps)
+    result = Array(graph, name, chunks, dtype=dtype)
+
+    if retstep:
+        if is_dask_collection(start):
+            start = start.compute()
+        if is_dask_collection(stop):
+            stop = stop.compute()
+        step = np.linspace(start, stop, num=num, endpoint=endpoint, retstep=True)[1]
+        return result, step
+    else:
+        return result
+
