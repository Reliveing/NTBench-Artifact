+cdef int _check_negative_binomial_params(double n, double p) except -1:
+    cdef double q
+    cdef double mu
+    cdef double sigma
+
+    check_constraint(n, 'n', CONS_POSITIVE_NOT_NAN)
+    check_constraint(p, 'p', CONS_BOUNDED_GT_0_1)
+    if p == 1.0:
+        return 0
+
+    q = (1.0 - p) / p
+    mu = n * q
+    sigma = sqrt(n) * q
+    if not (mu + 10.0 * sigma <= POISSON_LAM_MAX):
+        raise ValueError('n too large or p too small, see Generator.negative_binomial Notes')
+    return 0
