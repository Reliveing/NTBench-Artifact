+        # If f_num is an Add with a single Add base raised to a high
+        # integer power, solve in terms of that base. This avoids expanding
+        # compact polynomial forms like 1 - 3*(x - 5)**8.
+        if f_num.is_Add:
+            add_args = [i for i in f_num.atoms(Add)
+                if i != f_num and symbol in i.free_symbols]
+            pows = [p for p in f_num.atoms(Pow)
