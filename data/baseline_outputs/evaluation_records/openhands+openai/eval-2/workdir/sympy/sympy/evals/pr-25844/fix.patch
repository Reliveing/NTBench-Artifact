+            if len(add_args) == 1 and pows:
+                gen = add_args[0]
+                t = Dummy('t')
+                ftry = f_num.xreplace({gen: t})
+                if not ftry.has(symbol):
+                    try:
+                        cv_sols = _solve(ftry, t, **flags)
+                        cv_inv = _vsolve(t - gen, symbol, **flags)
+                        result = [{symbol: i.subs(sol)} for i in cv_inv
+                            for sol in cv_sols]
+                        if len(result) > 2:
+                            flags['simplify'] = flags.get('simplify', False)
+                    except NotImplementedError:
+                        pass
+
+        if result is not False:
+            result = _remove_duplicate_solutions(result)
+
+            if flags.get('simplify', True):
+                result = [{k: d[k].simplify() for k in d} for d in result]
+                result = _remove_duplicate_solutions(result)
+                flags['simplify'] = False
+
+            if checkdens:
+                dens = _simple_dens(f, symbols)
+                result = [r for r in result if
+                          not any(checksol(d, r, **flags)
+                                  for d in dens)]
+            if check:
+                result = [r for r in result if
+                          checksol(f_num, r, **flags) is not False]
+            return result
+
