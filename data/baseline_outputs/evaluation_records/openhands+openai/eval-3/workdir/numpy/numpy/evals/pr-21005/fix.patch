+cdef double NEGATIVE_BINOMIAL_THRESHOLD = <double>POISSON_LAM_MAX
+
+
+cdef bint _negative_binomial_too_large(double n, double p):
+    cdef double q = (1.0 - p) / p
+    return n * q + 10.0 * sqrt(n) * q > NEGATIVE_BINOMIAL_THRESHOLD
+
+
+cdef int _check_negative_binomial(double n, double p) except -1:
+    if _negative_binomial_too_large(n, p):
+        raise ValueError("n too large or p too small, see Generator.negative_binomial Notes")
+    return 0
+
+
+cdef int _check_array_negative_binomial(np.ndarray n_arr, np.ndarray p_arr) except -1:
+    cdef double n, p
+    cdef np.npy_intp i, cnt
+    cdef np.broadcast it
+
+    it = np.PyArray_MultiIterNew2(n_arr, p_arr)
+    cnt = it.size
+    for i in range(cnt):
+        n = (<double*>np.PyArray_MultiIter_DATA(it, 0))[0]
+        p = (<double*>np.PyArray_MultiIter_DATA(it, 1))[0]
+        _check_negative_binomial(n, p)
+        np.PyArray_MultiIter_NEXT(it)
+    return 0
+
