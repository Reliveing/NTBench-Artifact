+cdef bint _negative_binomial_too_large(double n, double p):
+    cdef double q = 1.0 - p
+    cdef double mean = n * q / p
+    cdef double gamma_10_sigma = 10.0 * sqrt(n) * q / p
+    return mean + gamma_10_sigma > POISSON_LAM_MAX
+
+
+cdef int _check_negative_binomial_limit(double n, double p) except -1:
+    if _negative_binomial_too_large(n, p):
+        raise ValueError("n too large or p too small, see "
+                         "Generator.negative_binomial Notes")
+    return 0
+
+
+cdef int _check_array_negative_binomial_limit(
+        np.ndarray n, np.ndarray p) except -1:
+    with np.errstate(over='ignore', invalid='ignore'):
+        over_limit = (n * (1.0 - p) / p
+                      + 10.0 * np.sqrt(n) * (1.0 - p) / p)
+    if np.any(np.greater(over_limit, POISSON_LAM_MAX)):
+        raise ValueError("n too large or p too small, see "
+                         "Generator.negative_binomial Notes")
+    return 0
+
