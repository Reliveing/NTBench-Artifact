+# The liblinear TRON solver can overflow internally when values this large are
+# used in repeated products such as Hessian-vector dot products.
+_LIBLINEAR_MAX_FEATURE_VALUE = np.finfo(np.float64).max ** 0.25
+
+
+def _check_liblinear_feature_values(X, fit_intercept, intercept_scaling):
+    if sp.issparse(X):
+        X_data = X.data
+    else:
+        X_data = np.asarray(X)
+
+    if X_data.size == 0:
+        max_val = 0
+    else:
+        max_val = np.max(np.abs(X_data))
+
+    if fit_intercept:
+        max_val = max(max_val, abs(intercept_scaling))
+
+    if max_val > _LIBLINEAR_MAX_FEATURE_VALUE:
+        raise ValueError(
+            "The 'liblinear' solver cannot fit data with values larger than "
+            f"{_LIBLINEAR_MAX_FEATURE_VALUE:.0e}. The input data may contain "
+            "large values. Consider preprocessing your data with StandardScaler "
+            "or MinMaxScaler."
+        )
+
 
