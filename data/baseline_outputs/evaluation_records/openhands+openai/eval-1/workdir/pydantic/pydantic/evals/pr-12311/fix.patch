+_MISSING_JSON_REF = object()
+
+
+def _resolve_json_pointer(item: Any, json_ref: JsonRef) -> Any:
+    if json_ref == '#':
+        return item
+    if not json_ref.startswith('#/'):
+        return _MISSING_JSON_REF
+
+    current = item
+    for part in json_ref[2:].split('/'):
+        part = part.replace('~1', '/').replace('~0', '~')
+        if isinstance(current, dict):
+            if part not in current:
+                return _MISSING_JSON_REF
+            current = current[part]
+        elif isinstance(current, list):
+            try:
+                index = int(part)
+            except ValueError:
+                return _MISSING_JSON_REF
+            if index < 0:
+                return _MISSING_JSON_REF
+            try:
+                current = current[index]
+            except IndexError:
+                return _MISSING_JSON_REF
+        else:
+            return _MISSING_JSON_REF
+    return current
+
+
 def _get_all_json_refs(item: Any) -> set[JsonRef]:
     """Get all the definitions references from a JSON schema."""
     refs: set[JsonRef] = set()
