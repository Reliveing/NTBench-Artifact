+    def _defer_set_env(self, value: TomlTypes, unroll: Unroll) -> TomlTypes:
+        if isinstance(value, list):
+            result: list[TomlTypes] = []
+            for item in value:
+                unrolled = self._defer_set_env(item, unroll)
+                if isinstance(item, dict) and item.get("replace") and item.get("extend"):
+                    result.extend(cast("list[TomlTypes]", unrolled))
+                else:
+                    result.append(unrolled)
+            return result
+        if isinstance(value, dict):
+            if value.get("replace") == "env":
+                return self._defer_set_env_env_replace(value)
+            if value.get("replace") == "ref" and (of := value.get("of")):
+                path = self.section.SEP.join(validate(of, list[str]))
+                return self._defer_set_env(self.load_raw_from_root(path), unroll)
+            if value.get("replace"):
+                return unroll(value)
+            return {key: self._defer_set_env(val, unroll) for key, val in value.items()}
+        return value
+
+    @staticmethod
+    def _defer_set_env_env_replace(value: dict[str, TomlTypes]) -> TomlTypes:
+        marker = value.get("marker")
+        name = validate(value["name"], str)
+        if "default" in value:
+            default = validate(value["default"], str)
+            result = f"{{env:{name}:{default}}}"
+        else:
+            result = f"{{env:{name}}}"
+        return {"value": result, "marker": marker} if marker else result
+
     def found_keys(self) -> set[str]:
