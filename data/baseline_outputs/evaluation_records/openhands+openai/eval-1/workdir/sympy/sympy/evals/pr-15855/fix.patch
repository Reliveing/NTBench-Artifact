+def _has_contradictory_abs_conditions(cond):
+    from sympy.functions import Abs
+
+    args = cond.args if isinstance(cond, And) else (cond,)
+    abs_args = []
+    for arg in args:
+        if not arg.is_Relational:
+            continue
+        arg = arg.canonical
+        if arg.rel_op == '<' and arg.rhs == S.One and arg.lhs.func is Abs:
+            abs_args.append(arg.lhs.args[0])
+
+    for n, arg in enumerate(abs_args):
+        for other in abs_args[n + 1:]:
+            if powsimp(arg*other) == S.One:
+                return True
+    return False
+
