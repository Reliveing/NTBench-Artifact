+def _tsolve_canonical(i):
+    """Return the ``i``-th persistent canonical placeholder Dummy."""
+    while len(_tsolve_canonical_cache) <= i:
+        _tsolve_canonical_cache.append(
+            Dummy("tsolve_canonical_%d" % len(_tsolve_canonical_cache)))
+    return _tsolve_canonical_cache[i]
+
