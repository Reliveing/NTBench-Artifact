+def _tsolve_canonicalize(eq, sym):
+    """Return ``eq`` with ``sym`` and any auxiliary Dummy symbols replaced by
+    fixed placeholders so that equations which are structurally identical
+    (differing only in the Dummy symbols they contain) compare equal.
+    """
+    reps = {sym: _tsolve_canonical_sym}
+    other = ordered(d for d in eq.free_symbols
+                    if d.is_Dummy and d != sym)
+    for i, d in enumerate(other):
+        reps[d] = _tsolve_canonical(i)
+    return eq.xreplace(reps)
