+        def not_a_huge_power(base, exp):
+            # bool to tell whether ``base**exp`` can be formed without
+            # producing an unreasonably large explicit number; combining
+            # e.g. ``10**1000000000`` from ``1000000000*log(10)`` is not a
+            # simplification and can be prohibitively expensive to compute
+            if not (base.is_Number and exp.is_Number):
+                return True
+            try:
+                b = abs(base)
+                e = abs(exp)
+                if b in (S.Zero, S.One):
+                    return True
+                # estimate the number of digits of base**exp; if it would be
+                # very large, refuse to combine
+                from sympy import log as _log
+                size = float(e)*float(_log(b, 10))
+                return size < 1000
+            except (TypeError, ValueError):
+                return True
