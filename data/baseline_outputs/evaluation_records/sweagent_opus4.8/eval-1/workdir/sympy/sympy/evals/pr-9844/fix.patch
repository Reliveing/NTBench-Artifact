+def _combine_exponential_bases(integrand, symbol):
+    """Combine constant-base powers whose exponents are proportional to each
+    other into a single power, e.g. ``3**x*5**(-x)`` becomes ``(3/5)**x``.
+    """
+    coeff = sympy.S.One
+    groups = {}
+    for arg in sympy.Mul.make_args(integrand):
+        base, exp = arg.as_base_exp()
+        if symbol in exp.free_symbols and symbol not in base.free_symbols:
+            const, reduced = exp.as_independent(symbol, as_Add=False)
+            groups.setdefault(reduced, []).append((base, const))
+        else:
+            coeff *= arg
+
+    result = coeff
+    combined = False
+    for reduced, items in groups.items():
+        if len(items) > 1:
+            combined = True
+        new_base = sympy.S.One
+        for base, const in items:
+            new_base *= base ** const
+        result *= new_base ** reduced
+
+    if combined:
+        return result
+    return integrand
+
+combine_exponential_rule = rewriter(
+    lambda integrand, symbol: isinstance(integrand, sympy.Mul),
+    _combine_exponential_bases)
