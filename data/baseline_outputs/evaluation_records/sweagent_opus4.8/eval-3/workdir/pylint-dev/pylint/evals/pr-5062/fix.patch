+    def _get_hashes(
+        self, lineset: "LineSet"
+    ) -> Tuple[HashToIndex_T, IndexToLines_T]:
+        """Return (and cache) the hashes for a given lineset.
+
+        The hashes only depend on the lineset content and ``self.min_lines`` so
+        they can be computed once per lineset instead of once per pair of
+        linesets. This avoids recomputing them ``len(self.linesets) - 1`` times
+        which was a serious performance bottleneck (leading to what looked like
+        a hang) on projects containing a lot of similar lines.
+        """
+        cached = self._hashes_cache.get(id(lineset))
+        if cached is None:
+            cached = hash_lineset(lineset, self.min_lines)
+            self._hashes_cache[id(lineset)] = cached
+        return cached
+
     def _iter_sims(self) -> Generator[Commonality, None, None]:
         """iterate on similarities among all files, by making a cartesian
         product
         """
+        # The hashes computed by ``_find_common`` only depend on the lineset and
+        # ``self.min_lines``. Reset the cache before each full computation so
+        # that it does not grow indefinitely and always reflects the current
+        # linesets.
+        self._hashes_cache = {}
         for idx, lineset in enumerate(self.linesets[:-1]):
             for lineset2 in self.linesets[idx + 1 :]:
                 yield from self._find_common(lineset, lineset2)
