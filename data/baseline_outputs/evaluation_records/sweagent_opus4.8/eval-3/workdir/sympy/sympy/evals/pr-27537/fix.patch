+def _log_pow_is_too_big(base, exp):
+    """Return True if ``base**exp`` would be an unwieldy number.
+
+    This is used by :func:`logcombine` to avoid transforming, e.g.,
+    ``1000000000*log(10)`` into ``log(10**1000000000)`` which would require
+    materializing an enormous integer.
+    """
+    import math
+
+    # Only worry about (real) numeric bases and exponents.
+    if not (base.is_Number and exp.is_Number):
+        return False
+    if base.is_zero or base is S.NaN or exp is S.NaN:
+        return False
+    if not (base.is_extended_real and exp.is_extended_real):
+        return False
+
+    # Estimate the number of decimal digits of ``base**exp``.  For a rational
+    # result this is roughly ``|exp| * log10(|base|)``; a value larger than a
+    # few thousand digits is considered too big to expand eagerly.
+    try:
+        b = abs(float(base))
+        e = abs(float(exp))
+    except (TypeError, ValueError, OverflowError):
+        return False
+    if b == 0 or b == 1:
+        return False
+    return e * abs(math.log10(b)) > 1000
+
