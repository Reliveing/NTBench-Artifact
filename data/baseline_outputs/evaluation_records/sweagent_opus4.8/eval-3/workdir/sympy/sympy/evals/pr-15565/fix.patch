+    def _eval_subs(self, old, new):
+        from sympy.core.power import Pow
+        if old.is_Pow and old.base == self:
+            # treat self as self**1 so that e.g. x.subs(sqrt(x), y) -> y**2;
+            # this is only done when old is a proper (positive integer) root
+            # of self so that x.subs(1/x, z) is left unchanged
+            e = old.exp
+            if e.is_Rational and e.is_positive and (S.One/e).is_Integer:
+                return Pow(self, S.One, evaluate=False)._eval_subs(old, new)
+
