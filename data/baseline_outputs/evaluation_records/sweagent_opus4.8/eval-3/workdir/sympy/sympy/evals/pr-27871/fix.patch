+def _int_to_str(i):
+    """Convert a (possibly very large) integer to its decimal string.
+
+    Python limits the number of digits allowed when converting between
+    ``int`` and ``str`` (see ``sys.set_int_max_str_digits``).  SymPy is able
+    to produce exact integers with more than the default limit of digits
+    (for example ``harmonic(10000)``), so the limit is raised temporarily to
+    make sure that such results can always be printed.
+    """
+    import sys
+    i = int(i)
+    try:
+        return str(i)
+    except ValueError:
+        # The number of digits exceeds ``sys.get_int_max_str_digits()``
+        # (available on Python 3.11+ and some earlier patch releases).
+        if not hasattr(sys, "set_int_max_str_digits"):
+            raise
+        old_limit = sys.get_int_max_str_digits()
+        # An integer with ``d`` bits has about ``d*log10(2)`` decimal digits.
+        needed = int(i.bit_length() * 0.302) + 2
+        try:
+            sys.set_int_max_str_digits(max(old_limit, needed))
+            return str(i)
+        finally:
+            sys.set_int_max_str_digits(old_limit)
+
