+        def hoist_defs(json_schema: JsonSchemaValue) -> JsonSchemaValue:
+            """Hoist any inline ``$defs`` (e.g. returned from a custom ``__get_pydantic_json_schema__``)
+            into the top-level ``self.definitions``.
+
+            The inline definitions are given unique internal definition refs (to avoid collisions with
+            other definitions), while registering the original names as the preferred remapping choices.
+            This way, the standard definitions-remapping logic will restore the original names when there
+            is no collision, and disambiguate them otherwise.
+            """
+            inline_defs = json_schema.get('$defs')
+            if not isinstance(inline_defs, dict):
+                return json_schema
+
+            # Build a mapping from the original inline defs ref name to a unique internal defs ref name.
+            # We always use a distinct internal name (suffixed) so that the standard remapping logic has
+            # a guaranteed-unique fallback, while still preferring the original name when there's no collision.
+            remapped: dict[str, DefsRef] = {}
+            for name in inline_defs:
+                base = self.normalize_name(name)
+                self._collision_counter[base] += 1
+                unique_name = DefsRef(f'{base}--{self._collision_counter[base]}')
+                while (
+                    unique_name in self._prioritized_defsref_choices
+                    or unique_name in self.definitions
+                    or unique_name in remapped.values()
+                ):
+                    self._collision_counter[base] += 1
+                    unique_name = DefsRef(f'{base}--{self._collision_counter[base]}')
+                remapped[name] = unique_name
+
+            def remap_refs(obj: Any) -> Any:
+                # Inline `$defs` are always referenced using the default `#/$defs/{name}` template,
+                # regardless of the (possibly custom) `self.ref_template`. When registering the hoisted
+                # definitions, we rewrite these to use `self.ref_template` so they are picked up by the
+                # final definitions remapping.
+                if isinstance(obj, dict):
+                    new_obj: dict[str, Any] = {}
+                    for k, v in obj.items():
+                        if k == '$ref' and isinstance(v, str):
+                            for orig, new in remapped.items():
+                                if v == DEFAULT_REF_TEMPLATE.format(model=orig):
+                                    v = self.ref_template.format(model=new)
+                                    break
+                        new_obj[k] = remap_refs(v)
+                    return new_obj
+                elif isinstance(obj, list):
+                    return [remap_refs(v) for v in obj]
+                return obj
+
+            for name, def_schema in inline_defs.items():
+                defs_ref = remapped[name]
+                self.definitions[defs_ref] = remap_refs(def_schema)
+                json_ref = JsonRef(self.ref_template.format(model=defs_ref))
+                self.json_to_defs_refs[json_ref] = defs_ref
+                # Prefer the original name when remapping, falling back to the unique internal name.
+                preferred = DefsRef(self.normalize_name(name))
+                self._prioritized_defsref_choices[defs_ref] = [preferred, defs_ref]
+
+            json_schema = {k: v for k, v in json_schema.items() if k != '$defs'}
+            json_schema = remap_refs(json_schema)
+            return json_schema
+
