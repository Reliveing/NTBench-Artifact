+def _pivot_tracker(T, pivcol, r, c, piv):
+    """Apply to the basis-inverse tracker ``T`` the same transformation
+    that :func:`_pivot` applies to a non-pivot column when pivoting
+    ``M`` about ``M[r, c]``.  ``pivcol`` is the (constraint part of the)
+    pivot column ``M[:m, c]`` and ``piv`` is the pivot value ``M[r, c]``.
+    ``T`` starts as the identity and, transformed in lockstep with the
+    constant column of ``M``, provides the perturbation used by the
+    lexicographic minimum-ratio rule to prevent cycling.
+    """
+    Ti = T[r, :]
+    new = T - pivcol * (Ti / piv)
+    new[r, :] = Ti / piv
+    return new
+
+
+def _choose_pivot_row(A, B, candidate_rows, pivot_col, T, Y):
+    # Choose the leaving variable with the lexicographic minimum ratio
+    # rule. The plain minimum ratio rule (B[i]/A[i, pivot_col]) can lead
+    # to cycling on degenerate problems; comparing, in the case of ties,
+    # the ratios formed with the columns of the tracked basis-inverse
+    # matrix ``T`` (which starts as the identity) makes the choice
+    # equivalent to a lexicographic perturbation of ``B`` and guarantees
+    # that the simplex method terminates without cycling.  ``Y`` is used
+    # as a final, deterministic tie-breaker.
+    def key(i):
+        d = A[i, pivot_col]
+        return tuple([B[i] / d] + [T[i, j] / d for j in range(T.cols)] +
+            [Y[i]])
+
+    return min(candidate_rows, key=key)
 
 
