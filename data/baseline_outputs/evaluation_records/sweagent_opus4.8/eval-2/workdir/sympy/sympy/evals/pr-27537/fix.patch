+        def hugepow(b, e):
+            # bool to tell whether ``b**e`` would be an astronomically large
+            # number and therefore should not be created (e.g. by moving a
+            # large coefficient inside ``log(b)``).  Building such a power
+            # -- for instance ``10**10000000`` -- is exact but extremely slow
+            # and the result is not a useful simplification.
+            if not (b.is_Rational and e.is_Rational):
+                return False
+            # (rough) number of bits needed to store the base
+            base_bits = max(abs(b.p).bit_length(), abs(b.q).bit_length())
+            if base_bits <= 1:
+                # base is 0, 1 or -1: powers never grow
+                return False
+            # (rough) number of times the base is multiplied
+            exp = abs(e.p)//e.q
+            return base_bits*exp > 100000
+
