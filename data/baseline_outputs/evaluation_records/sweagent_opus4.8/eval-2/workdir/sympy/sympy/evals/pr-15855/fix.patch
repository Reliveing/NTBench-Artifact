+def _is_impossible_condition(cond):
+    """Return True if the (boolean) condition ``cond`` can be shown to be
+    unsatisfiable, e.g. ``And(Abs(x) < 1, Abs(1/x) < 1)``.
+
+    This is used to detect convergence conditions that can never be met so
+    that the corresponding hypergeometric sum is reported as unevaluated
+    (returning ``None``) instead of yielding a ``Piecewise`` that collapses
+    back to the original ``Sum`` and causes an infinite loop in ``doit``.
+    """
+    try:
+        return cond.as_set() == S.EmptySet
+    except (NotImplementedError, AttributeError):
+        return False
+
