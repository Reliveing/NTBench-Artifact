+    def _eval_subs(self, old, new):
+        from sympy import Pow
+        if old.is_Pow and old.base == self and \
+                old.exp.is_Rational and old.exp.is_positive and \
+                old.exp != 1 and self.is_commutative:
+            # handle a base being replaced by a power of it, e.g.
+            # x.subs(sqrt(x), y) -> y**2 (issue 6976); treat x as x**1
+            # and let Pow's subs logic combine the exponents
+            rv = Pow(self, S.One, evaluate=False)._eval_subs(old, new)
+            if rv is not None:
+                return rv
+        return None
