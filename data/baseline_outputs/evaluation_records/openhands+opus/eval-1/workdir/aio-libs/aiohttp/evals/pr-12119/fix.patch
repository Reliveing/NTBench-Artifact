                     if chunk[: len(SEP)] == SEP:
                         chunk = chunk[len(SEP) :]
                         self._chunk = ChunkState.PARSE_CHUNKED_SIZE
+                    elif chunk and not SEP.startswith(chunk):
+                        # Data present that does not match the expected CRLF
+                        # terminating the chunk, so the chunk-size did not
