--- a/dask/dataframe/multi.py
+++ b/dask/dataframe/multi.py
@@ -740,6 +740,14 @@ def pair_partitions(L, R):
     result = []
 
     n, m = len(L) - 1, len(R) - 1
+
+    # If the right divisions contain NaNs (e.g. an empty right dataframe), the
+    # comparisons below are always False and the algorithm would never make
+    # progress, leading to an infinite loop. In that case simply pair every
+    # left partition with the single (empty) right partition.
+    if any(r != r for r in R):
+        return [[(max(0, min(m - 1, 0)), None, None)] for _ in range(n)]
+
     i, j = 0, -1
     while j + 1 < m and R[j + 1] <= L[i]:
         j += 1
