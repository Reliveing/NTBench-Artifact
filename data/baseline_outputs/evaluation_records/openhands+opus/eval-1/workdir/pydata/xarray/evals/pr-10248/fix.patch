+def test_where_kwarg():
+    # ufuncs that pass an xarray object via the ``where`` keyword argument
+    # should not trigger infinite recursion (GH9880), e.g. np.fix.
+    xarray_obj = xr.DataArray([-2.7, 2.7, 3.9])
+    expected = xr.DataArray([-2.0, 2.0, 3.0])
+    assert_identical(np.fix(xarray_obj), expected)
