+def test_nested_generic_parametrization_late_cache() -> None:
+    # https://github.com/pydantic/pydantic/issues/10896
+    # Parametrizing a generic model whose base is itself a parametrized generic
+    # used to raise ``TypeError: mro() returned a non-class ('PydanticRecursiveRef')``
+    # because the late cache key depended on the (differing) typevar values rather
+    # than the resolved args.
+    T = TypeVar('T')
+
+    class GenericBaseModel(BaseModel, Generic[T]): ...
+
+    class EnumerableModel(GenericBaseModel[T]):
+        values: List[T]
+
+    T1 = TypeVar('T1')
+    T2 = TypeVar('T2')
+
+    class CombineModel(BaseModel, Generic[T1, T2]):
+        field_1: T1
+        field_2: T2
+
+    class EnumerableCombineModel(EnumerableModel[CombineModel[T1, T2]]): ...
+
+    concrete = EnumerableCombineModel[int, int]
+    instance = concrete(values=[CombineModel[int, int](field_1=1, field_2=2)])
+    assert instance.values[0].field_1 == 1
+    assert instance.values[0].field_2 == 2
+
+
 def test_generic_any_or_never() -> None:
