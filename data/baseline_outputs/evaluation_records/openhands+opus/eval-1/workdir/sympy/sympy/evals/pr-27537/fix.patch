+def test_logcombine_large_numeric_coeff():
+    # https://github.com/sympy/sympy/issues/27528
+    # combining a large numeric coefficient into a numeric log argument
+    # would create an unmanageably large number, e.g. log(10**(10**9))
+    x, z = symbols("x z")
+    assert logcombine(1000000000*log(10)) == 1000000000*log(10)
+    e = 1000000000*log(10)/(1000000000*z - 1123456789*log(x))
+    assert simplify(e) == e
+    # small numeric coefficients still combine
+    assert logcombine(3*log(2)) == log(8)
+    assert logcombine(2*log(3) + log(5)) == log(45)
+
+
 def test_logcombine_complex_coeff():
     i = Integral((sin(x**2) + cos(x**3))/x, x)
     assert logcombine(i, force=True) == i
