+        def bigexpo(b, e):
+            # bool to tell whether combining a numeric coefficient ``e`` into
+            # the numeric argument ``b`` of a log, i.e. e*log(b) -> log(b**e),
+            # would produce an unreasonably large number (which can freeze
+            # subsequent computations, see issue #27528). The size of
+            # ``b**e`` is estimated without actually computing it.
+            if not (b.is_Number and e.is_Number and e.is_extended_real):
+                return False
+            if b in (S.Zero, S.One, S.NegativeOne):
+                return False
+            try:
+                p, q = b.as_numer_denom()
+                bits = max(abs(int(p)).bit_length(), abs(int(q)).bit_length())
+                return bits*abs(float(e)) > 100000
+            except (TypeError, ValueError, OverflowError):
+                return False
+
