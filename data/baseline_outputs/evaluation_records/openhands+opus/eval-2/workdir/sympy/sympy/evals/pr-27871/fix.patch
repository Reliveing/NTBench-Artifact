+def _int_to_str_with_limit(value):
+    """Convert an integer to a string, raising the digit limit if needed.
+
+    Converting very large integers to strings can raise a ``ValueError``
+    because of the limit set by ``sys.set_int_max_str_digits``. This helper
+    temporarily raises the limit so that large integers (e.g. from
+    ``harmonic``) can be printed.
+    """
+    try:
+        return str(value)
+    except ValueError:
+        digits = len(hex(abs(int(value)))) * 4
+        old_limit = sys.get_int_max_str_digits()
+        try:
+            sys.set_int_max_str_digits(max(old_limit, digits))
+            return str(value)
+        finally:
+            sys.set_int_max_str_digits(old_limit)
+
