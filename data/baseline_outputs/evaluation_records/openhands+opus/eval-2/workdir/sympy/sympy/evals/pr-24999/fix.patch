+
+def test_issue_25297():
+    from sympy.core.mod import Mod
+    from sympy.functions.elementary.integers import floor
+    s2 = Symbol('s2', integer=True, positive=True)
+    f = floor(s2/2 - S.Half)
+    m = Mod(f**2/(f + 1) + 2*f/(f + 1) + 1/(f + 1), 1)
+    # this used to raise a RecursionError
+    raises(NotImplementedError, lambda: solve(m*f + m, s2))
