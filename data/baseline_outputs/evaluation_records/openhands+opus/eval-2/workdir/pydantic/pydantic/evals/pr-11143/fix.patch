+def test_nested_generic_with_multiple_typevars_does_not_raise_mro_error() -> None:
+    """Regression test for https://github.com/pydantic/pydantic/issues/11097
+    
+    This test ensures that nested generic models with multiple TypeVars don't 
+    incorrectly trigger recursion detection, which would cause:
+    TypeError: mro() returned a non-class ('PydanticRecursiveRef')
+    """
+    _T = TypeVar('_T')
+
+    class GenericBaseModel(BaseModel, Generic[_T]):
+        ...
+
+    class EnumerableModel(GenericBaseModel[_T]):
+        values: List[_T]
+
+    _T1 = TypeVar('_T1')
+    _T2 = TypeVar('_T2')
+
+    class CombineModel(BaseModel, Generic[_T1, _T2]):
+        field_1: _T1
+        field_2: _T2
+
+    class EnumerableCombineModel(EnumerableModel[CombineModel[_T1, _T2]]):
+        ...
+
+    # This should not raise TypeError about mro() returning a non-class
+    EnumerableCombineModelInt = EnumerableCombineModel[int, int]
+    
+    # Verify the model can be instantiated
+    instance = EnumerableCombineModelInt(
+        values=[CombineModel[int, int](field_1=1, field_2=2)]
+    )
+    assert instance.values[0].field_1 == 1
+    assert instance.values[0].field_2 == 2
