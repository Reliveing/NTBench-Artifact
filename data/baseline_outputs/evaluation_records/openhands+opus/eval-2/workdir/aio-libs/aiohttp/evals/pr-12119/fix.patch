diff --git a/CHANGES/10510.bugfix.rst b/CHANGES/10510.bugfix.rst
new file mode 100644
index 000000000..80cfa7b3b
--- /dev/null
+++ b/CHANGES/10510.bugfix.rst
@@ -0,0 +1,3 @@
+Fixed the pure Python HTTP parser hanging instead of rejecting a request with
+``400 Bad Request`` when the chunk-size did not match the actual data size in
+chunked transfer encoding -- by :user:`bdraco`.
diff --git a/aiohttp/http_parser.py b/aiohttp/http_parser.py
index c5560b7a5..3bf3734f1 100644
--- a/aiohttp/http_parser.py
+++ b/aiohttp/http_parser.py
@@ -889,6 +889,13 @@ class HttpPayloadParser:
                     if chunk[: len(SEP)] == SEP:
                         chunk = chunk[len(SEP) :]
                         self._chunk = ChunkState.PARSE_CHUNKED_SIZE
+                    elif chunk and not SEP.startswith(chunk):
+                        # The chunk data is not followed by the expected CRLF,
+                        # which means the chunk-size did not match the actual
+                        # data size.
+                        raise TransferEncodingError(
+                            "Chunk not properly terminated"
+                        )
                     else:
                         self._chunk_tail = chunk
                         return False, b""
