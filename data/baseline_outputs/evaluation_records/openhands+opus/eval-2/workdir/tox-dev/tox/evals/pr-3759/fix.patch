@@ -21,17 +21,22 @@ if TYPE_CHECKING:
 
 
 class Unroll:
-    def __init__(self, conf: Config | None, loader: TomlLoader, args: ConfigLoadArgs) -> None:
+    def __init__(
+        self, conf: Config | None, loader: TomlLoader, args: ConfigLoadArgs, *, skip_string_replace: bool = False
