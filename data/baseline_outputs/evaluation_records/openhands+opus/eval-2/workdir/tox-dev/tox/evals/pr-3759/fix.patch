diff --git a/docs/changelog/3736.bugfix.rst b/docs/changelog/3736.bugfix.rst
new file mode 100644
index 00000000..bec30890
--- /dev/null
+++ b/docs/changelog/3736.bugfix.rst
@@ -0,0 +1,3 @@
+Fix ``RecursionError`` when using substitutions that require environment creation (such as
+``{env_site_packages_dir}``) inside ``set_env`` in TOML configuration - previously such values were
+resolved eagerly, now they are deferred like in the INI loader.
diff --git a/src/tox/config/loader/toml/__init__.py b/src/tox/config/loader/toml/__init__.py
index eb48936e..08ba21a4 100644
--- a/src/tox/config/loader/toml/__init__.py
+++ b/src/tox/config/loader/toml/__init__.py
@@ -68,11 +68,23 @@ class TomlLoader(Loader[TomlTypes]):
         raw: TomlTypes,
         args: ConfigLoadArgs,
     ) -> _T:
-        exploded = Unroll(conf=conf, loader=self, args=args)(raw)
-        result = self.to(exploded, of_type, factory)
         if inspect.isclass(of_type) and issubclass(of_type, SetEnv):
-            result.use_replacer(lambda c, s: c, args=args)  # noqa: ARG005
-        return result
+            # do not eagerly resolve plain string substitutions for set_env, as this can trigger a recursion cycle
+            # (e.g. {env_site_packages_dir} requires creating the environment, which reads set_env again);
+            # dict-level constructs (replace/ref/marker) are still expanded, but plain string substitution
+            # is deferred to a replacer applied lazily when each value is loaded
+            exploded = Unroll(conf=conf, loader=self, args=args, skip_string_replace=True)(raw)
+            result = self.to(exploded, of_type, factory)
+
+            def replacer(raw_: str, args_: ConfigLoadArgs) -> str:
+                if conf is None:
+                    return raw_
+                return cast("str", Unroll(conf=conf, loader=self, args=args_)(raw_))
+
+            result.use_replacer(replacer, args=args)
+            return result
+        exploded = Unroll(conf=conf, loader=self, args=args)(raw)
+        return self.to(exploded, of_type, factory)
 
     def found_keys(self) -> set[str]:
         return set(self.content.keys()) - self._unused_exclude
