diff --git a/CHANGES/10930.bugfix.rst b/CHANGES/10930.bugfix.rst
new file mode 100644
index 000000000..102cd7f65
--- /dev/null
+++ b/CHANGES/10930.bugfix.rst
@@ -0,0 +1,3 @@
+Fixed the server hanging indefinitely when a chunked request's ``chunk-size``
+does not match the actual chunk data size; the request is now rejected with a
+``400 Bad Request`` -- by :user:`bdraco`.
diff --git a/aiohttp/http_parser.py b/aiohttp/http_parser.py
index c5560b7a5..14c285a0a 100644
--- a/aiohttp/http_parser.py
+++ b/aiohttp/http_parser.py
@@ -889,6 +889,14 @@ class HttpPayloadParser:
                     if chunk[: len(SEP)] == SEP:
                         chunk = chunk[len(SEP) :]
                         self._chunk = ChunkState.PARSE_CHUNKED_SIZE
+                    elif chunk and not SEP.startswith(chunk[: len(SEP)]):
+                        # The chunk data is not terminated by CRLF, which
+                        # means the chunk-size did not match the actual data.
+                        exc = TransferEncodingError(
+                            "Chunk not properly terminated"
+                        )
+                        set_exception(self.payload, exc)
+                        raise exc
                     else:
                         self._chunk_tail = chunk
                         return False, b""
