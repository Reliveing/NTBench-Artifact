@@ -830,6 +830,34 @@ def rewrites_rule(integral):
         rewritten = integrand.subs(1/sympy.cos(symbol), sympy.sec(symbol))
         return RewriteRule(rewritten, integral_steps(rewritten, symbol), integrand, symbol)
 
+def _is_constant_base_exponential(expr, symbol):
+    return (isinstance(expr, sympy.Pow) and expr.base.is_number
+            and symbol in expr.exp.free_symbols)
+
+def _rewrite_exponentials(integrand, symbol):
+    # Rewrite constant-base exponentials such as 2**x into exp(x*log(2))
+    # so that products and quotients can be combined and integrated.
+    rewritten = integrand.replace(
+        lambda expr: _is_constant_base_exponential(expr, symbol),
+        lambda expr: sympy.exp(sympy.log(expr.base) * expr.exp))
+    return sympy.powsimp(rewritten.expand(), deep=True, force=True)
+
+def exponential_rule(integral):
+    integrand, symbol = integral
+
+    if not integrand.has(sympy.Pow):
+        return
+
+    if not any(_is_constant_base_exponential(expr, symbol)
+               for expr in integrand.atoms(sympy.Pow)):
+        return
+
+    rewritten = _rewrite_exponentials(integrand, symbol)
+    if rewritten != integrand:
+        substep = integral_steps(rewritten, symbol)
+        if not contains_dont_know(substep):
+            return RewriteRule(rewritten, substep, integrand, symbol)
+
 def fallback_rule(integral):
     return DontKnowRule(*integral)
 
