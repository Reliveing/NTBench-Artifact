+    def _extract_embedded_defs(self, json_schema: JsonSchemaValue) -> None:
+        """Hoist any ``$defs`` embedded in a user-provided JSON schema into the generator's definitions.
+
+        When a ``__get_pydantic_json_schema__`` method returns a schema that carries its own ``$defs``
+        (for example, a schema copied from another model's ``model_json_schema()`` output), those
+        definitions and their local ``$ref`` targets are unknown to the generator. This registers them so
+        that reference counting and definitions handling work correctly.
+        """
+        embedded_defs = json_schema.pop('$defs', None)
+        if not isinstance(embedded_defs, dict):
+            return
+
+        for defs_ref, def_schema in embedded_defs.items():
+            defs_ref = DefsRef(defs_ref)
+            json_ref = JsonRef(self.ref_template.format(model=defs_ref))
+            self.definitions.setdefault(defs_ref, def_schema)
+            self.json_to_defs_refs.setdefault(json_ref, defs_ref)
+            self._prioritized_defsref_choices.setdefault(defs_ref, [defs_ref])
+
