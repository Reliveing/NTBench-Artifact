+        delay_replace = inspect.isclass(of_type) and issubclass(of_type, SetEnv)
+        # for set_env defer leaf string substitution to avoid eagerly triggering environment creation
+        exploded = Unroll(conf=conf, loader=self, args=args, unroll_strings=not delay_replace)(raw)
         result = self.to(exploded, of_type, factory)
-        if inspect.isclass(of_type) and issubclass(of_type, SetEnv):
-            result.use_replacer(lambda c, s: c, args=args)  # noqa: ARG005
+        if delay_replace:
+
+            def replacer(raw_: str, args_: ConfigLoadArgs) -> str:
+                if conf is None:
+                    return raw_
+                reference = TomlReplaceLoader(conf, self)
+                return replace(conf, reference, raw_, args_)
+
+            result.use_replacer(replacer, args=args)
         return result
 
     def found_keys(self) -> set[str]:
