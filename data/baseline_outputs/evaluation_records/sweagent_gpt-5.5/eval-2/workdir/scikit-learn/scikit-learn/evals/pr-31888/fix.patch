@@ -41,6 +41,36 @@ from sklearn.utils.validation import (
 
 LIBSVM_IMPL = ["c_svc", "nu_svc", "one_class", "epsilon_svr", "nu_svr"]
 
+# The trust-region Newton solver used by liblinear forms products that can
+# involve up to the fourth power of feature values. For very large values,
+# those intermediate quantities can overflow to inf/NaN before liblinear can
+# detect convergence reliably. Warn users early with actionable guidance.
+_LIBLINEAR_SAFE_MAX = np.finfo(np.float64).max ** 0.25
+
+
+def _warn_if_liblinear_has_large_features(X):
+    """Warn if X may overflow liblinear's internal calculations."""
+    if sp.issparse(X):
+        data = X.data
+        if data.size == 0:
+            return
+        max_abs = np.max(np.abs(data))
+    else:
+        if X.size == 0:
+            return
+        max_abs = np.max(np.abs(X))
+
+    if max_abs > _LIBLINEAR_SAFE_MAX:
+        warnings.warn(
+            "The 'liblinear' solver may fail to converge or produce unstable "
+            "results because the input features have very large absolute "
+            f"values. The largest absolute value in X is {max_abs:.3e}, "
+            f"which exceeds the safe threshold {_LIBLINEAR_SAFE_MAX:.3e}. "
+            "Please scale or standardize your data before fitting a model "
+            "with liblinear.",
+            ConvergenceWarning,
+        )
+
 
 def _one_vs_one_coef(dual_coef, n_support, support_vectors):
     """Generate primal coefficients from dual coefficients
@@ -1228,6 +1258,8 @@ def _fit_liblinear(
     if sp.issparse(X):
         _check_large_sparse(X)
 
