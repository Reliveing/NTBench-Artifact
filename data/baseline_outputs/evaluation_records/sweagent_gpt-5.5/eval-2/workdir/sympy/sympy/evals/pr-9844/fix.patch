     lambda integrand, symbol: integrand.is_rational_function(),
     lambda integrand, symbol: integrand.apart(symbol))
 
+def _symbol_in_constant_base_power(integrand, symbol):
+    for power in integrand.find(sympy.Pow):
+        base, exp = power.as_base_exp()
+        if symbol not in base.free_symbols and symbol in exp.free_symbols:
+            return True
+    return False
+
+powsimp_rule = rewriter(
+    lambda integrand, symbol: (
+        isinstance(integrand, (sympy.Mul, sympy.Pow)) and
+        _symbol_in_constant_base_power(integrand, symbol)),
+    lambda integrand, symbol: sympy.powsimp(integrand))
+
+exp_distribute_expand_rule = rewriter(
+    lambda integrand, symbol: (
+        isinstance(integrand, sympy.Mul) and
+        any(isinstance(arg, sympy.Add) for arg in integrand.args) and
+        _symbol_in_constant_base_power(integrand, symbol)),
+    lambda integrand, symbol: integrand.expand())
+
 distribute_expand_rule = rewriter(
     lambda integrand, symbol: (
         all(arg.is_Pow or arg.is_polynomial(symbol) for arg in integrand.args)
@@ -912,39 +932,46 @@ def _integral_is_subclass(integral):
