+    def _harmonic(n, m):
+        """Compute the exact generalized harmonic number H_{n,m}.
+
+        A balanced (binary splitting) summation keeps intermediate integers
+        much smaller than the straightforward recurrence
+
+            H_n = H_{n-1} + 1/n**m
+
+        and avoids caching every intermediate rational.  This is especially
+        important for large n, where the numerator and denominator of H_n have
+        thousands of digits.
+        """
+        if n == 0:
+            return S.Zero
+
+        def _sum(a, b):
+            if a == b:
+                return 1, a**m
+            mid = (a + b) // 2
+            p1, q1 = _sum(a, mid)
+            p2, q2 = _sum(mid + 1, b)
+            p = p1*q2 + p2*q1
+            q = q1*q2
+            g = gcd(p, q)
+            return p//g, q//g
+
+        p, q = _sum(1, n)
+        return Rational(p, q)
 
