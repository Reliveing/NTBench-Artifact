+def _int_to_decimal_string(expr):
+    """Return the decimal representation of an integer.
+
+    Python 3.11 limits conversion of very large integers to decimal
+    strings by default.  SymPy's printers need to be able to display exact
+    integer and rational values whose numerators/denominators exceed that
+    limit, so retry the conversion with the limit temporarily disabled.
+    """
+    try:
+        return str(expr)
+    except ValueError:
+        get_digits = getattr(sys, "get_int_max_str_digits", None)
+        set_digits = getattr(sys, "set_int_max_str_digits", None)
+        if get_digits is None or set_digits is None:
+            raise
+        old = get_digits()
+        try:
+            set_digits(0)
+            return str(expr)
+        finally:
+            set_digits(old)
+
