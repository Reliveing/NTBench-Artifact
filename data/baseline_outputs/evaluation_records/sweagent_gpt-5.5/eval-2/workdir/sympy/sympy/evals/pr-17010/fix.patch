+def _has_negative_leading_term(expr):
+    """Return True if the leading term of ``expr`` is negative.
+
+    This is used for symbolic polynomial indices where a rewrite of a
+    negative index should only be performed if it makes the highest order
+    term positive.  Using ``could_extract_minus_sign`` on the whole
+    expression can be unstable under shifted negative-index recurrences,
+    e.g. both ``1 - n`` and ``-(- (1 - n) - 2) - 2`` may be considered to
+    have extractable minus signs, leading to infinite recursion.
+    """
+    if not expr.is_Add:
+        return expr.could_extract_minus_sign()
+
+    def key(term):
+        return term.extract_multiplicatively(-1).sort_key() \
+            if term.could_extract_minus_sign() else term.sort_key()
+
+    terms = [term for term in expr.args if not term.is_number]
+    if not terms:
+        terms = list(expr.args)
+    return max(terms, key=key).could_extract_minus_sign()
+
 
