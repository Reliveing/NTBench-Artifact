+    def _add_theory_conflict(self, cls):
+        """Add an LRA conflict clause and backtrack to make it active.
+
+        Theory conflicts are discovered only after a complete Boolean
+        assignment has been found.  The conflict clause returned by the
+        theory solver is false under that assignment, so merely appending it
+        to the clause database is not enough: the same complete assignment
+        would otherwise remain in force and the same theory conflict could be
+        reported repeatedly.  Backtrack until one of the assignments falsifying
+        the new clause has been undone.  The next simplification/decision will
+        then see the learned clause and either propagate from it or explore a
+        different branch.
+        """
+        if not cls:
+            return False
+
+        self._simple_add_learned_clause(cls)
+
+        # The learned clause is already unsatisfied by the current assignment.
+        # If all of the assignments that falsify it were made at level 0, then
+        # the Boolean abstraction plus theory is unsatisfiable.
+        while len(self.levels) > 1:
+            if any(-lit in self._current_level.var_settings for lit in cls):
+                self._undo()
+                self._simplify()
+                if not self.is_unsatisfied:
+                    return True
+                self.is_unsatisfied = False
+            else:
+                self._undo()
+
+        self._simplify()
+        return not self.is_unsatisfied
+
