+def _linspace_chunk(start, stop, num, endpoint, dtype, blockstart, blocksize):
+    range_ = stop - start
+    div = (num - 1) if endpoint else num
+    step = float(range_) / div
+
+    blockstart = start + (step * blockstart)
+    bs_space = blocksize - 1 if endpoint else blocksize
+    blockstop = blockstart + (bs_space * step)
+    return np.linspace(blockstart, blockstop, blocksize, endpoint=endpoint, dtype=dtype)
