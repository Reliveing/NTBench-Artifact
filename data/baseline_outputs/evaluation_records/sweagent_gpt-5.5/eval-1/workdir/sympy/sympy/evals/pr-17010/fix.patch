+def _negative_leading_term(expr):
+    """Return True if ``expr`` has a leading minus sign.
+
+    This is used for canonicalizing polynomial indices.  The more general
+    ``could_extract_minus_sign`` can be true for both an expression and a
+    shifted negation of it (for example ``n - m`` and ``m - n - 2``), which
+    can make identities for negative indices recurse indefinitely.  For sums,
+    decide from the leading non-numeric term instead: this removes a minus
+    sign from the highest-order term and leaves the canonicalized expression
+    alone on the next evaluation.
+    """
+    if not expr.is_Add:
+        return expr.could_extract_minus_sign()
+
+    ordered_terms = expr.as_ordered_terms()
+    leading_terms = [term for term in ordered_terms if not term.is_number]
+    if not leading_terms:
+        leading_terms = ordered_terms
+    return leading_terms[0].could_extract_minus_sign()
+
 
