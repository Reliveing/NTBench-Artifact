+def _resolve_local_json_ref(root: Any, ref: JsonRef) -> Any | None:
+    """Resolve a local JSON reference against a schema, returning ``None`` if it cannot be resolved."""
+    if ref == '#':
+        return root
+    if not ref.startswith('#/'):
+        return None
+
+    current = root
+    for part in ref[2:].split('/'):
+        part = part.replace('~1', '/').replace('~0', '~')
+        if isinstance(current, dict):
+            try:
+                current = current[part]
+            except KeyError:
+                return None
+        elif isinstance(current, list):
+            try:
+                current = current[int(part)]
+            except (ValueError, IndexError):
+                return None
+        else:
+            return None
+    return current
+
+
+def _has_local_json_ref(item: Any, ref: JsonRef) -> bool:
+    """Return whether a local JSON reference can be resolved anywhere within a schema."""
+    stack = [item]
+    while stack:
+        current = stack.pop()
+        if _resolve_local_json_ref(current, ref) is not None:
+            return True
+        if isinstance(current, dict):
+            stack.extend(v for k, v in current.items() if k != 'examples' or not isinstance(v, list))
+        elif isinstance(current, list):
+            stack.extend(current)
+    return False
+
+
 def _get_all_json_refs(item: Any) -> set[JsonRef]:
     """Get all the definitions references from a JSON schema."""
     refs: set[JsonRef] = set()
