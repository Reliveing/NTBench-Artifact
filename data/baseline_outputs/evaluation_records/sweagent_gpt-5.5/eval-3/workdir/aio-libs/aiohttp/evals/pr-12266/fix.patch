--- a/aiohttp/compression_utils.py
+++ b/aiohttp/compression_utils.py
@@ -330,6 +330,7 @@ class ZSTDDecompressor(DecompressionBaseHandler):
                 "Please install `backports.zstd` module"
             )
         self._obj = ZstdDecompressor()
+        self._unused_data = b""
         super().__init__(executor=executor, max_sync_chunk_size=max_sync_chunk_size)
 
     def decompress_sync(
@@ -342,7 +343,37 @@ class ZSTDDecompressor(DecompressionBaseHandler):
             if max_length == ZLIB_MAX_LENGTH_UNLIMITED
             else max_length
         )
-        return self._obj.decompress(data, zstd_max_length)
+
+        if zstd_max_length == 0:
+            return b""
+
+        if self._unused_data:
+            data = self._unused_data + data
+            self._unused_data = b""
+
+        chunks: list[bytes] = []
+        remaining = zstd_max_length
+        while True:
+            if self._obj.eof:
+                self._obj = ZstdDecompressor()
+
+            chunk = self._obj.decompress(data, remaining)
+            if chunk:
+                chunks.append(chunk)
+                if remaining != ZSTD_MAX_LENGTH_UNLIMITED:
+                    remaining -= len(chunk)
+                    if remaining == 0:
+                        if self._obj.eof:
+                            self._unused_data = self._obj.unused_data
+                        break
+
+            if self._obj.eof and self._obj.unused_data:
+                data = self._obj.unused_data
+                continue
+
+            break
+
+        return b"".join(chunks)
 
     def flush(self) -> bytes:
         return b""
