+def _simplex_iterate(M, X, Y):
+    # Pivot from a feasible solution to an optimal one.
+    n = M.cols - 1
+    m = M.rows - 1
+
+    while True:
+        B = M[:-1, -1]
+        A = M[:-1, :-1]
+        C = M[-1, :-1]
+
+        # Choose a pivot column, c
+        piv_cols = [_ for _ in range(n) if C[_] < 0]
+        if not piv_cols:
+            break
+        _, c = min((X[i], i) for i in piv_cols)  # Bland's rule
+
+        # Choose a pivot row, r
+        piv_rows = [_ for _ in range(m) if A[_, c] > 0]
+        if not piv_rows:
+            raise UnboundedLPError(filldedent("""
+                Objective function can assume
+                arbitrarily large values!"""))
+        r = _choose_pivot_row(A, B, piv_rows, c, Y)
+
+        M = _pivot(M, r, c)
+        X[c], Y[r] = Y[r], X[c]
+
+    return M, X, Y
+
+
+def _restore_objective(M, C, D, X, Y):
+    # Restore the original objective row for the current basis.
+    n = M.cols - 1
+    m = M.rows - 1
+    row = zeros(1, n + 1)
+
+    for i, (v, j) in enumerate(X):
+        if v == False:
+            row[i] = C[j]
+    row[-1] = D[0]
+
+    for i, (v, j) in enumerate(Y):
+        if v == False:
+            row -= C[j]*M[i, :]
+
+    M[m, :] = row
+    return M
+
