+def _polynomial_order_could_extract_minus_sign(expr):
+    """Return True if minus sign extraction canonicalizes an order.
+
+    This is similar to ``could_extract_minus_sign`` but for polynomial
+    orders we prefer the sign for which the highest ordered term is
+    positive.  This prevents order reflection formulae such as
+    ``U_n -> -U_{-n-2}`` from oscillating between two forms whose signs
+    are both extractable according to the more general expression sign
+    heuristic.
+    """
+    if not expr.could_extract_minus_sign():
+        return False
+    if expr.is_Add:
+        lead = expr.as_ordered_terms(order='lex')[0]
+        if lead.could_extract_minus_sign():
+            return True
+        if (-lead).could_extract_minus_sign():
+            return False
+    return True
+
 
