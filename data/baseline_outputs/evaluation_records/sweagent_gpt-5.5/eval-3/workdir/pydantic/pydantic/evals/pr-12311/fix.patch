+def _add_json_schema_definition_views(
+    json_schema: JsonSchemaValue, definitions: dict[DefsRef, JsonSchemaValue]
+) -> JsonSchemaValue:
+    if not definitions:
+        return json_schema
+
+    json_schema = json_schema.copy()
+    json_schema['$defs'] = {**json_schema.get('$defs', {}), **definitions}
+    return json_schema
+
+
+def _get_all_locally_resolvable_json_refs(item: Any) -> set[JsonRef]:
+    refs: set[JsonRef] = set()
+    stack: list[tuple[Any, str]] = [(item, '#')]
+
+    while stack:
+        current, path = stack.pop()
+        if isinstance(current, dict):
+            refs.add(JsonRef(path))
+            for key, value in current.items():
+                escaped_key = str(key).replace('~', '~0').replace('/', '~1')
+                if isinstance(value, dict):
+                    stack.append((value, f'{path}/{escaped_key}'))
+                elif isinstance(value, list):
+                    stack.extend(
+                        (item, f'{path}/{escaped_key}/{index}')
+                        for index, item in enumerate(value)
+                        if isinstance(item, (dict, list))
+                    )
+        elif isinstance(current, list):
+            stack.extend(
+                (item, f'{path}/{index}') for index, item in enumerate(current) if isinstance(item, (dict, list))
+            )
+
+    return refs
+
+
 def _get_all_json_refs(item: Any) -> set[JsonRef]:
     """Get all the definitions references from a JSON schema."""
     refs: set[JsonRef] = set()
