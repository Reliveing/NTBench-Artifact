--- a/sklearn/svm/_base.py
+++ b/sklearn/svm/_base.py
@@ -1228,6 +1228,24 @@ def _fit_liblinear(
     if sp.issparse(X):
         _check_large_sparse(X)
 
+    # Very large feature values can overflow intermediate products in
+    # liblinear's TRON optimizer and lead to poor convergence. Warn early with
+    # an actionable message instead of only reporting a generic convergence
+    # failure after fitting. The fourth root keeps products of squared norms
+    # away from the floating point overflow limit.
+    if sp.issparse(X):
+        X_max = np.max(np.abs(X.data)) if X.data.size else 0
+    else:
+        X_max = np.max(np.abs(X)) if X.size else 0
+    if X_max > np.finfo(np.float64).max ** 0.25:
+        warnings.warn(
+            "Liblinear may fail to converge, or produce inaccurate results, "
+            "because the input data contains very large values. You might "
+            "want to scale the data as shown in:\n"
+            "    https://scikit-learn.org/stable/modules/preprocessing.html",
+            ConvergenceWarning,
+        )
+
     # LibLinear wants targets as doubles, even for classification
     y_ind = np.asarray(y_ind, dtype=np.float64).ravel()
     y_ind = np.require(y_ind, requirements="W")
