-                    return [S.false]
-                rel.append(c)
+                # Normalize for contradiction detection
+                x_norm = _normalize_abs_rel(x)
+                c_norm = x_norm.canonical
+                nc = (~c_norm).canonical
+                for r in rel_norm:
+                    if r == nc or _implies(r, nc):
+                        return [S.false]
+                rel.append(c_orig)
+                rel_norm.append(c_norm)
             newargs.append(x)
         return LatticeOp._new_args_filter(newargs, And)
 
