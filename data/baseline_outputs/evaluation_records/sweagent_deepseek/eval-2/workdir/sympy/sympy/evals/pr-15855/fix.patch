     @classmethod
     def _new_args_filter(cls, args):
+        from sympy.functions import Abs
+        from sympy.core.relational import (Relational, StrictLessThan,
+            StrictGreaterThan, LessThan, GreaterThan)
+
+        def _normalize_abs_rel(rel):
+            """Normalize Abs inequalities like Abs(1/x) < 1 -> Abs(x) > 1."""
+            if not isinstance(rel, Relational):
+                return rel
+            lhs, rhs = rel.lhs, rel.rhs
+            if isinstance(lhs, Abs) and len(lhs.args) == 1:
+                arg = lhs.args[0]
+                if arg.is_Pow and arg.exp == -1:
+                    f = arg.base
+                    if isinstance(rel, StrictLessThan):
+                        return Abs(f) > 1/rhs
+                    elif isinstance(rel, LessThan):
+                        return Abs(f) >= 1/rhs
+                    elif isinstance(rel, StrictGreaterThan):
+                        return Abs(f) < 1/rhs
+                    elif isinstance(rel, GreaterThan):
+                        return Abs(f) <= 1/rhs
+            return rel
+
+        def _implies(r, nc):
+            """Check if relational r implies relational nc (r is stricter)."""
+            if not isinstance(r, Relational) or not isinstance(nc, Relational):
+                return False
+            if r.lhs != nc.lhs or r.rhs != nc.rhs:
+                return False
+            if isinstance(r, StrictLessThan) and isinstance(nc, LessThan):
+                return True
+            if isinstance(r, StrictGreaterThan) and isinstance(nc, GreaterThan):
+                return True
+            return False
+
         newargs = []
