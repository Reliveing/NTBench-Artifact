+def _get_union_orderings_for_cache(typevar_values: Any) -> tuple[Any, ...]:
+    """Extract the ordering of items in any Union types present in `typevar_values`.
+
+    This is similar to `_union_orderings_key` but does not preserve the tuple structure of `typevar_values`.
+    This is important because two different sets of `typevar_values` can represent the same final type
+    (e.g., `GenericBaseModel[CombineModel[int, int]]` vs `GenericBaseModel[CombineModel][int, int]`),
+    and we want the late cache to handle these equivalently. The tuple structure is an artifact of
+    the parametrization path and should not affect cache lookups.
+
+    For Union types, the order of union arguments is preserved, as this affects validation behavior.
+    """
+    if isinstance(typevar_values, tuple):
+        result: list[Any] = []
+        for value in typevar_values:
+            if _typing_extra.is_union(value):
+                result.append(get_args(value))
+        return tuple(result)
+    elif _typing_extra.is_union(typevar_values):
+        return (typevar_values,)
+    else:
+        return ()
+
