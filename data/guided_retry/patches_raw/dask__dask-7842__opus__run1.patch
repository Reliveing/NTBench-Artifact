diff --git a/dask/dataframe/multi.py b/dask/dataframe/multi.py
index 278d434ac..79212a07d 100644
--- a/dask/dataframe/multi.py
+++ b/dask/dataframe/multi.py
@@ -740,6 +740,14 @@ def pair_partitions(L, R):
     result = []
 
     n, m = len(L) - 1, len(R) - 1
+    
+    # If all right divisions are NaN (empty right dataframe), the comparisons
+    # below are always False and the algorithm would never make progress,
+    # leading to an infinite loop. In that case, pair every left partition
+    # with the single (empty) right partition.
+    if all(r != r for r in R):
+        return [[(0, None, None)] for _ in range(n)]
+    
     i, j = 0, -1
     while j + 1 < m and R[j + 1] <= L[i]:
         j += 1
